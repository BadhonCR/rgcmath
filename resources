    <style>
        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:Segoe UI,Tahoma,Geneva,Verdana,sans-serif;
        }

        body{
            background:#f4f7fb;
            color:#333;
        }

        .hero{
            background:linear-gradient(135deg,#003366,#0056b3);
            color:#fff;
            text-align:center;
            padding:70px 20px;
        }

        .hero h1{
            font-size:40px;
            margin-bottom:10px;
        }

        .hero p{
            font-size:18px;
            opacity:.95;
        }

        .container{
            width:90%;
            max-width:1200px;
            margin:auto;
            padding:40px 0;
        }

        .section-title{
            color:#003366;
            border-left:6px solid #0056b3;
            padding-left:12px;
            margin-bottom:25px;
            font-size:28px;
        }

        .resource-card{
            background:#fff;
            border-radius:12px;
            padding:20px;
            margin-bottom:40px;
            box-shadow:0 5px 15px rgba(0,0,0,.08);
        }

        table{
            width:100%;
            border-collapse:collapse;
        }

        table th{
            background:#003366;
            color:#fff;
            padding:12px;
        }

        table td{
            padding:12px;
            border-bottom:1px solid #ddd;
        }

        table tr:hover{
            background:#f2f7ff;
        }

        .btn{
            display:inline-block;
            background:#0056b3;
            color:#fff;
            padding:8px 16px;
            border-radius:5px;
            text-decoration:none;
            transition:.3s;
            font-size:14px;
        }

        .btn:hover{
            background:#003366;
        }

        .year-title{
            font-size:24px;
            color:#0056b3;
            margin:30px 0 15px;
        }

        .links{
            display:grid;
            grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
            gap:20px;
        }

        .link-box{
            background:#fff;
            border-radius:10px;
            padding:20px;
            text-align:center;
            box-shadow:0 4px 10px rgba(0,0,0,.08);
        }

        .link-box i{
            font-size:40px;
            color:#0056b3;
            margin-bottom:15px;
        }

        .link-box h3{
            margin-bottom:10px;
            color:#003366;
        }

        footer{
            background:#003366;
            color:#fff;
            text-align:center;
            padding:20px;
            margin-top:50px;
        }

        @media(max-width:768px){

            table{
                display:block;
                overflow-x:auto;
            }

            .hero h1{
                font-size:30px;
            }

        }

    </style>

</head>

